# Copy this file to .env for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Database (Phase 2) ---
# Any Postgres connection string works: Neon, Supabase, Vercel Postgres, Railway, etc.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth (Phase 2) ---
# A long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- AI Assistant (Phase 5) ---
# Get a key from console.x.ai -> API Keys -> Create API Key
GROK_API_KEY=
# Optional — defaults to grok-4-1-fast (cheap, fast) if not set
GROK_MODEL=

# --- Payments (Phase 6, not needed yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Password reset emails (Phase 6) ---
# Resend API key. Free tier: 3000 emails/month, no card required.
PASSWORD_KEY=
# Optional — defaults to Resend's shared onboarding@resend.dev sender,
# which only reliably delivers to your own Resend account email until you
# verify your own domain. Once verified: EMAIL_FROM=VedicAstro <noreply@yourdomain.com>
EMAIL_FROM=
